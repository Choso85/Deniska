<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Нажми меня</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0a0a0a;
    font-family: 'Segoe UI', system-ui, sans-serif;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
  }

  #btn {
    padding: 24px 60px;
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, #667eea, #764ba2, #f093fb, #f5576c);
    background-size: 300% 300%;
    border: none;
    border-radius: 60px;
    cursor: pointer;
    box-shadow: 0 10px 40px rgba(240, 87, 108, 0.5), 0 0 80px rgba(118, 75, 162, 0.3);
    animation: gradientShift 3s ease infinite, pulse 2s ease-in-out infinite;
    transition: transform 0.15s;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #btn:hover { transform: scale(1.05); }
  #btn:active { transform: scale(0.95); }

  @keyframes gradientShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 10px 40px rgba(240,87,108,0.5), 0 0 80px rgba(118,75,162,0.3); }
    50%      { box-shadow: 0 10px 60px rgba(240,87,108,0.9), 0 0 120px rgba(118,75,162,0.6); }
  }

  #text {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(2rem, 12vw, 10rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 4px;
    text-align: center;
    padding: 20px;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.3) rotate(-10deg);
    background: linear-gradient(90deg, #ff0080, #ff8c00, #ffd700, #00ff88, #00d4ff, #a855f7, #ff0080);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 20px rgba(255,255,255,0.3)) drop-shadow(0 0 40px rgba(255,0,128,0.5));
    z-index: 10;
  }

  #text.show {
    animation: 
      appear 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      rainbow 2s linear infinite,
      wiggle 1.5s ease-in-out infinite;
  }

  @keyframes appear {
    to { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  @keyframes rainbow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }

  @keyframes wiggle {
    0%, 100% { transform: scale(1) rotate(-2deg); }
    50%      { transform: scale(1.08) rotate(2deg); }
  }

  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 5;
    animation: fall 3s linear forwards;
  }

  @keyframes fall {
    0%   { transform: translateY(-20px) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
  }

  .hint {
    position: fixed;
    bottom: 30px;
    color: rgba(255,255,255,0.4);
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
</style>
</head>
<body>

  <button id="btn">Нажми на меня</button>
  <div id="text">денис иди нахуй</div>
  <div class="hint">кликни ещё раз чтобы увидеть снова</div>

<script>
  const btn = document.getElementById('btn');
  const text = document.getElementById('text');
  const colors = ['#ff0080','#ff8c00','#ffd700','#00ff88','#00d4ff','#a855f7','#f5576c','#667eea'];

  function boom() {
    // перезапуск анимации текста
    text.classList.remove('show');
    void text.offsetWidth;
    text.classList.add('show');

    // конфетти
    for (let i = 0; i < 80; i++) {
      const c = document.createElement('div');
      c.className = 'confetti';
      c.style.left = Math.random() * 100 + 'vw';
      c.style.background = colors[Math.floor(Math.random() * colors.length)];
      c.style.animationDuration = (1.5 + Math.random() * 2) + 's';
      c.style.animationDelay = Math.random() * 0.4 + 's';
      c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      c.style.width = c.style.height = (6 + Math.random() * 12) + 'px';
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 3500);
    }
  }

  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    boom();
  });

  document.body.addEventListener('click', boom);
</script>

</body>
</html>
